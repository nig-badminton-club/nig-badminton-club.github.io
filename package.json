{
  "name": "nig-badminton-club",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "python3 -m http.server 4173 --directory docs",
    "lint": "node scripts/check_javascript.mjs",
    "validate:html": "html-validate \"docs/*.html\"",
    "test": "node --test tests/*.test.mjs && python3 -B -m unittest discover -s tests -p '*_test.py'",
    "check": "node scripts/check.mjs",
    "validate:site": "python3 scripts/validate_site.py"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "html-validate": "11.8.0",
    "jsdom": "30.1.3"
  }
}
