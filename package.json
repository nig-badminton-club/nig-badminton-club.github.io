{
  "name": "nig-badminton-club",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "python3 -m http.server 4173 --directory docs",
    "lint": "node scripts/check_javascript.mjs",
    "validate:html": "html-validate \"docs/*.html\"",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run validate:html && npm run validate:site && npm test",
    "validate:site": "python3 scripts/validate_site.py"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "html-validate": "11.5.6",
    "jsdom": "30.0.1"
  }
}
